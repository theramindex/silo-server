{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramindex.org/contracts/livetv-v1/schema.json",
  "title": "livetv/v1 plugin contract",
  "description": "Wire shapes for the /silo-compat/livetv/v1 routes. See contract.md.",
  "$defs": {
    "info": {
      "type": "object",
      "properties": {
        "contractVersion": { "type": "integer", "const": 1 },
        "name": { "type": "string" },
        "streamHosts": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["contractVersion", "name", "streamHosts"],
      "additionalProperties": true
    },
    "channel": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "name": { "type": "string" },
        "logoUrl": { "type": "string" },
        "groupId": { "type": "string" },
        "group": { "type": "string" }
      },
      "required": ["id", "number", "name", "logoUrl", "groupId", "group"],
      "additionalProperties": true
    },
    "channels": {
      "type": "array",
      "items": { "$ref": "#/$defs/channel" }
    },
    "stream": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "container": { "type": "string", "enum": ["ts", "hls"] },
        "mode": { "type": "string", "enum": ["redirect", "server"] }
      },
      "required": ["url", "container", "mode"],
      "additionalProperties": true
    },
    "profilePrefs": {
      "type": "object",
      "properties": {
        "favorites": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "favoriteOrder": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hiddenCategories": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      },
      "additionalProperties": true
    }
  }
}
